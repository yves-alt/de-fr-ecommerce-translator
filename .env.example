# =============================================================================
# German to French E-commerce Translator — Environment Configuration
# =============================================================================
#
# SETUP:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your real values below
#   3. NEVER commit .env to version control
#
# =============================================================================

# OpenAI API key — get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Admin account credentials
ADMIN_EMAIL=your_admin_email_here
ADMIN_PASSWORD=your_admin_password_here

# Guest demo account credentials
GUEST_EMAIL=your_guest_email_here
GUEST_PASSWORD=your_guest_password_here

# Standard user account credentials
JUSTUS_EMAIL=your_justus_email_here
JUSTUS_PASSWORD=your_justus_password_here

# =============================================================================
# Issue Reporting — SMTP (optional)
# Leave blank to disable email notifications (reports still saved to SQLite).
# =============================================================================

REPORT_EMAIL_TO=yves.banga@home24.de
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=localization@example.com
