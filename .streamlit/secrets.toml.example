# =============================================================================
# Streamlit Community Cloud Secrets — EXAMPLE FILE
# =============================================================================
#
# Copy the content below into your app's Secrets panel:
#   Streamlit Cloud → App settings → Secrets
#
# NEVER commit the real secrets.toml file — it is already in .gitignore.
#
# =============================================================================

OPENAI_API_KEY = "your_openai_api_key_here"

# Admin account credentials
ADMIN_EMAIL    = "your_admin_email_here"
ADMIN_PASSWORD = "your_admin_password_here"

# Guest demo account credentials
GUEST_EMAIL    = "your_guest_email_here"
GUEST_PASSWORD = "your_guest_password_here"

# Standard user account credentials
JUSTUS_EMAIL    = "your_justus_email_here"
JUSTUS_PASSWORD = "your_justus_password_here"

# =============================================================================
# Issue Reporting — SMTP email configuration (optional)
# If left empty, reports are saved in SQLite only (no email notification).
# =============================================================================

# Recipient address for issue report notifications
REPORT_EMAIL_TO = "yves.banga@home24.de"

# SMTP server settings
SMTP_HOST     = "smtp.example.com"
SMTP_PORT     = "587"
SMTP_USER     = "your-smtp-username"
SMTP_PASSWORD = "your-smtp-password"
SMTP_FROM     = "localization@example.com"
